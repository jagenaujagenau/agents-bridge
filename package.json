{
  "name": "agentbridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc -p . && tsc -p examples/replay",
    "test": "vitest run",
    "check": "tsc -p . && tsc -p examples/replay && vitest run",
    "schemas": "node packages/schema/scripts/generate-json-schemas.ts",
    "bridge": "node packages/cli/src/bin.ts",
    "audit:local": "node packages/platform-node/scripts/audit-local-history.ts",
    "update-golden": "UPDATE_GOLDEN=1 vitest run",
    "replay": "pnpm --filter @agentbridge/example-replay dev"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "^26.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
